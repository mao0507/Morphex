{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MediaForge",
  "version": "0.1.0",
  "identifier": "com.mediaforge.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "MediaForge",
        "width": 1080,
        "height": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/backend"],
    "resources": ["resources/backend/**/*"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
